{
  "name": "spidey-hang",
  "productName": "Spidey Hang",
  "version": "1.0.0",
  "description": "Spider-Man hangs upside down from a web on your desktop (Windows, macOS and Linux). Drag him and he swings.",
  "main": "src/main.js",
  "desktopName": "spidey-hang.desktop",
  "private": true,
  "license": "MIT",
  "author": "Ashish Manhas",
  "homepage": "https://github.com/ashishmanhas231/Hang-in-there#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashishmanhas231/Hang-in-there.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit.test.js",
    "test:e2e": "node test/e2e.js",
    "perf": "node scripts/perf.js",
    "dist": "node scripts/dist.js",
    "dist:win": "node scripts/dist.js --win",
    "dist:mac": "node scripts/dist.js --mac",
    "dist:linux": "node scripts/dist.js --linux"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.spideyhang.app",
    "productName": "Spidey Hang",
    "copyright": "Copyright (c) Ashish Manhas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/test-view.js"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "en-US",
      "en_US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Ashish Manhas",
      "synopsis": "Spider-Man hangs from a web on your desktop",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "publish": null
  }
}
